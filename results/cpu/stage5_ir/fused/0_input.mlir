func.func @entry(%a: tensor<250x170xf32>, %b: tensor<170x330xf32>, %bias: tensor<330xf32>) -> tensor<250x330xf32> {
  %0 = tforge.matmul %a, %b : tensor<250x170xf32>, tensor<170x330xf32> -> tensor<250x330xf32>
  %1 = tforge.bias_add %0, %bias : tensor<250x330xf32>, tensor<330xf32> -> tensor<250x330xf32>
  %2 = tforge.relu %1 : tensor<250x330xf32> -> tensor<250x330xf32>
  return %2 : tensor<250x330xf32>
}
